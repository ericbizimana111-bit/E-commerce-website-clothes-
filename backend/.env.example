# Server Configuration
PORT=4000
# Bind address: 0.0.0.0 (all interfaces) is required for container deployment;
# localhost-only setups may set HOST=127.0.0.1.
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# NEVER put a real password in this tracked file — copy to backend/.env (gitignored).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/uganda_food_marketplace?schema=public

# JWT Authentication
# Minimum 16 chars in development/test; minimum 32 chars in production.
# JWT_SECRET and ADMIN_JWT_SECRET MUST be different from each other.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_a_different_secure_secret_for_admins
ADMIN_JWT_EXPIRES_IN=1d

# Initial Administrator Accounts (for seeding; never commit real passwords)
# In production these two passwords must be set explicitly in the environment.
ADMIN_1_EMAIL=admin@ugandafood.market
ADMIN_1_PASSWORD=change_this_admin_password_in_env
ADMIN_1_NAME=Primary Admin
ADMIN_2_EMAIL=ops@ugandafood.market
ADMIN_2_PASSWORD=change_this_ops_password_in_env
ADMIN_2_NAME=Operations Admin

# CORS Configuration (comma-separated origins)
# Development default below. In production, list EXPLICIT origins — the
# wildcard "*" is rejected because credentials are enabled.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Warehouse / Distribution Hub Coordinates (Nakasero Market, Kampala)
WAREHOUSE_LATITUDE=0.3136
WAREHOUSE_LONGITUDE=32.5811

# Payment Gateway Configuration (Abstraction layer)
# Active provider: MOCK (development/tests only — refused in production at
# startup and in payment.service) or a future real adapter (FLUTTERWAVE,
# MTN_MOMO, ...; see docs/PAYMENTS_API.md).
PAYMENT_PROVIDER=MOCK
# HMAC-SHA256 secret used by the active provider adapter to sign/verify webhook
# payloads over the RAW request body. Use a long random value (min 32 chars in
# production, where it is REQUIRED — no default is applied); never commit the
# real one.
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signature_secret
# Payment attempt TTL (minutes) before an unverified attempt is marked EXPIRED
PAYMENT_ATTEMPT_TTL_MINUTES=30

# Delivery Pricing Default Rules
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_RADIUS_KM=3.0
DELIVERY_PER_KM_RATE=1200
DELIVERY_MINIMUM_FEE=3000

# Commitment Default Rule (Percentage or Flat)
COMMITMENT_RULE_TYPE=PERCENTAGE
COMMITMENT_PERCENTAGE=30.0
COMMITMENT_MIN_AMOUNT=5000
