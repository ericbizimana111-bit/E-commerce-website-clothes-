# Server Configuration
PORT=4000
# Bind address: 0.0.0.0 (all interfaces) is required for container deployment;
# localhost-only setups may set HOST=127.0.0.1.
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# NEVER put a real password in this tracked file — copy to backend/.env (gitignored).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/uganda_food_marketplace?schema=public

# JWT Authentication
# Minimum 16 chars in development/test; minimum 32 chars in production.
# JWT_SECRET and ADMIN_JWT_SECRET MUST be different from each other.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_a_different_secure_secret_for_admins
ADMIN_JWT_EXPIRES_IN=1d

# Initial Administrator Accounts (for seeding; never commit real passwords)
# In production these two passwords must be set explicitly in the environment.
ADMIN_1_EMAIL=admin@ugandafood.market
ADMIN_1_PASSWORD=change_this_admin_password_in_env
ADMIN_1_NAME=Primary Admin
ADMIN_2_EMAIL=ops@ugandafood.market
ADMIN_2_PASSWORD=change_this_ops_password_in_env
ADMIN_2_NAME=Operations Admin

# CORS Configuration (comma-separated origins)
# Development default below. In production, list EXPLICIT origins — the
# wildcard "*" is rejected because credentials are enabled.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://localhost:5173

# Warehouse / Distribution Hub Coordinates (Nakasero Market, Kampala)
WAREHOUSE_LATITUDE=0.3136
WAREHOUSE_LONGITUDE=32.5811

# Payment Gateway Configuration (Abstraction layer)
# Active provider: MOCK (development/tests only — refused in production at
# startup and in payment.service) or the real FLUTTERWAVE adapter (see
# docs/PAYMENTS_API.md and src/services/paymentProviders/flutterwaveProvider.js).
PAYMENT_PROVIDER=MOCK
# TEST | LIVE — TEST (sandbox) is the default; never run LIVE with test keys.
PAYMENT_MODE=TEST
# Flutterwave credentials (ONLY when PAYMENT_PROVIDER=FLUTTERWAVE).
# Use the dashboard TEST keys for sandbox/development. NEVER commit real keys —
# copy them into backend/.env (gitignored). The SECRET key lives server-side
# only: it must never reach frontend code, tests, docs, or git.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Payment return URL: Flutterwave may redirect the customer's browser here after
# a mobile money authorization step. Must be a PUBLIC HTTPS URL in production
# (e.g. https://api.ugamarket.ug/api/payments/return). Card payments are NOT
# accepted — UgaMarket takes MTN MoMo and Airtel Money only.
FLW_RETURN_URL=http://localhost:4000/api/payments/return
# Webhook secret hash: configured in the Flutterwave dashboard and compared
# (timing-safe) against the incoming `verif-hash` header by the adapter.
# Shared with the MOCK provider (same env var, different verification scheme).
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signature_secret
# Payment attempt TTL (minutes) before an unverified attempt is marked EXPIRED
PAYMENT_ATTEMPT_TTL_MINUTES=30
# Frontend base URL: used by the /api/payments/return handler to redirect the
# customer back to their order page after card payment.
FRONTEND_URL=http://localhost:3000

# Location services (address validation + maps + road distance).
# NOMINATIM / OSRM use the free public OpenStreetMap services by default
# (fine for development and low volume; self-host for heavy production use).
# NONE disables network calls (tests always run with NONE).
GEOCODER_PROVIDER=NOMINATIM
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_CONTACT_EMAIL=support@ugamarket.ug
ROUTING_PROVIDER=OSRM
OSRM_URL=https://router.project-osrm.org
ROAD_DISTANCE_FACTOR=1.35

# Automatic translation of catalogue names (admins write English only).
# MYMEMORY: free, no key (weak Luganda) | GOOGLE: best quality, needs a key |
# LIBRETRANSLATE: self-hosted | NONE: disabled (English fallback everywhere)
TRANSLATION_PROVIDER=MYMEMORY
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=

# Delivery Pricing Default Rules
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_RADIUS_KM=3.0
DELIVERY_PER_KM_RATE=1200
DELIVERY_MINIMUM_FEE=3000

# Commitment Default Rule (Percentage or Flat)
COMMITMENT_RULE_TYPE=PERCENTAGE
COMMITMENT_PERCENTAGE=30.0
COMMITMENT_MIN_AMOUNT=5000
