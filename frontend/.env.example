# UgaMarket — home to home | Customer Web App environment configuration
#
# Copy this file to `.env.local` (or `.env.development.local`) and adjust values.
# NEVER commit real `.env*` files — they are gitignored. The frontend only ever
# needs public configuration (API location); all secrets live on the backend.

# Base URL of the UgaMarket backend API (no trailing slash).
# Development default: the Express server in backend/ (PORT 4000).
# PRODUCTION: set REACT_APP_API_URL to the public backend API base URL at
# build/deploy time (e.g. https://api.<your-domain>/api). It is PUBLIC
# configuration — never place secrets in frontend environment variables.
REACT_APP_API_URL=http://localhost:4000/api
