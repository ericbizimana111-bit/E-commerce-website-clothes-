# ── UgaMarket production environment template ────────────────────────────────
# Copy to .env.production (gitignored) and replace EVERY <PLACEHOLDER> with a
# real value. NEVER commit .env.production. Generate secrets with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Validation: production startup FAILS FAST if required secrets are missing,
# placeholder values, too short (<32 chars), or JWT secrets are identical
# (see backend/src/config/envValidation.js).

# ── Runtime ──
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── PostgreSQL (compose service `postgres`) ──
# These three are used by the postgres container; DATABASE_URL is consumed by
# Prisma inside the backend container (`postgres` = compose service name).
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public

# ── Authentication secrets (min 32 chars, MUST differ from each other) ──
JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=<ADMIN_JWT_SECRET>
ADMIN_JWT_EXPIRES_IN=1d

# ── Initial admin accounts (seeding; explicit values REQUIRED in production) ──
ADMIN_1_EMAIL=admin@<your-domain>
ADMIN_1_PASSWORD=<ADMIN_1_PASSWORD>
ADMIN_1_NAME=Primary Admin
ADMIN_2_EMAIL=ops@<your-domain>
ADMIN_2_PASSWORD=<ADMIN_2_PASSWORD>
ADMIN_2_NAME=Operations Manager

# ── CORS: explicit production origins (wildcard "*" is rejected) ──
CORS_ORIGIN=https://<customer-domain>,https://<admin-domain>

# ── Payment: mobile money only (MTN MoMo, Airtel Money) via FLUTTERWAVE.
#    MOCK is refused in production. Card payments are not accepted. ──
PAYMENT_PROVIDER=FLUTTERWAVE
PAYMENT_MODE=LIVE
FLW_PUBLIC_KEY=<FLW_PUBLIC_KEY>
FLW_SECRET_KEY=<FLW_SECRET_KEY>
PAYMENT_WEBHOOK_SECRET=<PAYMENT_WEBHOOK_SECRET>
FRONTEND_URL=https://<customer-domain>

# ── Location services (address validation, maps, road distance) ──
# Public OpenStreetMap Nominatim allows ~1 request/second with an identifying
# contact; for high traffic self-host Nominatim/OSRM and point these at them.
GEOCODER_PROVIDER=NOMINATIM
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_CONTACT_EMAIL=support@<your-domain>
ROUTING_PROVIDER=OSRM
OSRM_URL=https://router.project-osrm.org
ROAD_DISTANCE_FACTOR=1.35

# ── Automatic translation of product/category/service names (English → LG/SW/FR) ──
# GOOGLE gives the best Luganda quality (recommended for production).
TRANSLATION_PROVIDER=GOOGLE
GOOGLE_TRANSLATE_API_KEY=<GOOGLE_TRANSLATE_API_KEY>

# ── Payment attempt TTL (minutes) ──
PAYMENT_ATTEMPT_TTL_MINUTES=30

# ── Warehouse / distribution hub (Nakasero Market, Kampala) ──
WAREHOUSE_LATITUDE=0.3136
WAREHOUSE_LONGITUDE=32.5811

# ── Delivery pricing defaults (UGX) ──
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_RADIUS_KM=3.0
DELIVERY_PER_KM_RATE=1200
DELIVERY_MINIMUM_FEE=3000

# ── Commitment rule defaults ──
COMMITMENT_RULE_TYPE=PERCENTAGE
COMMITMENT_PERCENTAGE=30.0
COMMITMENT_MIN_AMOUNT=5000
